.DS_Store
sources/*
logs/
public/immortalwrt
public/openwrt
public.zip
keys/private-key.pem

# Python 缓存（站点脚本已拆出 site_i18n.py / site_versions.py 等本地模块）
__pycache__/

# 构建期生成的目录列表页与落地页（CI 在部署前生成，不入库）
public/**/index.html

# 抓取到的上游版本事实（由 scripts/fetch-upstream-versions.py 生成，CI 内传递，不入库）
upstream-versions.json

# 浏览器调试截图（本地核验用，不入库）
browser-screenshots/

# 站点字体的源文件（91 MB，仅用于再生成子集；不入库，见 config/fonts.sha256）
fonts-src/
